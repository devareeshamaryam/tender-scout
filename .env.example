# Google Sheet ID: the long part of the URL docs.google.com/spreadsheets/d/<SHEET_ID>/edit
SHEET_ID=

# Service account key: either a path to the JSON file or the raw JSON on one line.
GOOGLE_SERVICE_ACCOUNT_JSON=./service-account.json

# Slack Incoming Webhook URL. If empty, the message is printed to the console instead.
SLACK_WEBHOOK_URL=

# IT relevance filter (comma separated, whole-word match on title + description).
# Leave unset to use the built-in IT/recruitment list. Set BOTH to * to keep every award.
# KEYWORDS=software,digital,cloud,cyber,data,recruitment
# CPV code prefixes, default 72 (IT services) and 48 (software)
# CPV_PREFIXES=72,48

# Days of awards re-read each run (already-saved ones are skipped). Default 7.
# AWARD_LOOKBACK_DAYS=7
# Minimum award value in GBP; other currencies converted approximately. Default 250000.
# AWARD_MIN_GBP=250000
# TED buyer countries as ISO3 codes, comma separated. Default * (all EU).
# TED_COUNTRIES=IRL,NLD,DEU,BEL

# --- Apollo: likely hiring manager at each new winner (needs a PAID Apollo plan) ---
# Leave empty to skip. Create at Apollo > Settings > Integrations > API.
APOLLO_API_KEY=
# Credit control (~1 credit per company + 1 per contact revealed). Defaults 10 and 2.
# APOLLO_MAX_COMPANIES_PER_RUN=10
# APOLLO_CONTACTS_PER_COMPANY=2
# Titles to look for, in priority order (comma separated).
# APOLLO_TITLES=head of talent acquisition,talent acquisition manager,head of recruitment,engineering manager,cto

# --- Proposal drafts: Claude writes one tailored email per signal, posted to Slack for review ---
# Nothing is emailed automatically. Leave empty to skip. Create at console.anthropic.com.
ANTHROPIC_API_KEY=
# Drafts per run (each job). Default 20.
# PROPOSALS_PER_RUN=20
# A hiring-spike company gets at most one draft in this many days. Default 30.
# PROPOSAL_COOLDOWN_DAYS=30
# Who the emails are from and what you offer - Claude only claims what is written here.
# PROPOSAL_SENDER_PROFILE=Ateca (ateca.co.uk), a UK technology recruitment partner...

# --- Hiring velocity (npm run hiring): Workable + Lever job feeds, no key needed ---
# Separate spreadsheet (and optionally service account) for the hiring tabs.
# Both default to SHEET_ID / GOOGLE_SERVICE_ACCOUNT_JSON. Share the sheet with the account as Editor.
# HIRING_SHEET_ID=
# HIRING_GOOGLE_SERVICE_ACCOUNT_JSON=./service-account-hiring.json
# Lever starter companies (jobs.lever.co/<slug>); tender award winners are also checked for Lever pages.
# LEVER_COMPANIES=palantir,spotify,zopa,scottlogic,veeva,sonarsource
# LEVER_MAX_NEW_PER_RUN=100
# Workable companies are found automatically by searching jobs.workable.com (comma separated).
# WORKABLE_LOCATIONS=United Kingdom,Ireland
# WORKABLE_QUERIES=software engineer,developer,devops,data engineer,engineering manager
# Search result pages per query/location (20 jobs each). Default 10.
# WORKABLE_SEARCH_PAGES=10
# New companies looked up per run; the rest wait for the next run. Default 60.
# WORKABLE_MAX_NEW_PER_RUN=60
# Comma-separated overrides of the built-in lists:
# ENGINEERING_KEYWORDS=engineer,developer,devops,sre,architect,qa
# STACKS=python,node.js,react,aws,kubernetes
# Spike = open engineering jobs >= SPIKE_RATIO x baseline and up by >= SPIKE_MIN_INCREASE.
# SPIKE_RATIO=1.5
# SPIKE_MIN_INCREASE=3
# BASELINE_DAYS=14
# Alert when this many new engineering jobs / jobs naming one stack appear within 7 days.
# BURST_MIN_NEW_ENG=5
# STACK_SPIKE_MIN=3
